{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "packages/cli": {
      "ignoreDependencies": ["ejs", "prettier", "prettier-plugin-java"]
    },
    "e2e": {
      "ignoreDependencies": ["gen-agent", "@gen-agent/web"],
      "ignoreBinaries": ["helm"]
    },
    "packages/templates": {
      "entry": ["scripts/*.js"]
    }
  },
  "ignore": ["packages/templates/minimal/**", "packages/templates/src/__snapshots__/**"],
  "ignoreIssues": {
    "packages/web/components/ui/**": ["exports", "types"]
  }
}
