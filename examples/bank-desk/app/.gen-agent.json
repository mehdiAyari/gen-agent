{
  "generator": {
    "name": "gen-agent",
    "version": "0.1.0"
  },
  "config": {
    "agent": {
      "name": "bank-desk",
      "description": "Helps the customers of the bank check their balance and send transfers",
      "profile": "production",
      "java": 21,
      "build": "maven",
      "springAi": "2.0.1",
      "model": {
        "provider": "ollama",
        "name": "qwen2.5:7b",
        "temperature": 0,
        "fallback": {
          "provider": "ollama",
          "name": "qwen2.5:3b"
        }
      },
      "prompt": {
        "system": "prompts/system.md",
        "aiDisclosure": true
      },
      "memory": {
        "retention": "30d",
        "window": 20,
        "type": "jdbc"
      },
      "tools": [
        {
          "name": "account-balance",
          "description": "Balance of the account of the signed-in customer, in euros",
          "params": [],
          "type": "java"
        },
        {
          "name": "send-transfer",
          "description": "Sends a transfer from the account of the signed-in customer",
          "params": [
            {
              "name": "iban",
              "type": "string",
              "required": true,
              "description": "the IBAN of the recipient, as the customer wrote it"
            },
            {
              "name": "amount",
              "type": "number",
              "required": true,
              "description": "the amount, in euros"
            }
          ],
          "approval": {
            "required": true
          },
          "type": "java"
        }
      ],
      "interface": [
        "rest",
        "chat-ui"
      ],
      "deploy": [
        "docker-compose",
        "helm"
      ],
      "security": {
        "piiMasking": true,
        "injectionDetection": true,
        "outputGuard": true,
        "killSwitches": true,
        "auth": "oidc",
        "rateLimit": "30/min",
        "tokenBudget": "100000/day"
      },
      "limits": {
        "maxIterations": 8,
        "timeout": "5m"
      },
      "cache": {
        "exact": "redis",
        "semantic": {
          "threshold": 0.95,
          "scope": "user"
        }
      },
      "gdpr": {
        "erasureEndpoint": true,
        "logsWithoutPii": true
      },
      "observability": {
        "otel": true,
        "metrics": "prometheus",
        "grafanaDashboard": true,
        "feedback": true
      },
      "evals": {
        "dataset": "evals/golden.yaml",
        "redTeam": true,
        "ciModel": "ollama"
      }
    }
  },
