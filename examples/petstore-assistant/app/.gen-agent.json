  "config": {
    "agent": {
      "name": "petstore-assistant",
      "description": "Helps the customers of the pet store find a pet",
      "profile": "minimal",
      "java": 21,
      "build": "maven",
      "springAi": "2.0.1",
      "model": {
        "provider": "ollama",
        "name": "qwen2.5:7b",
        "temperature": 0
      },
      "prompt": {
        "system": "prompts/system.md",
        "aiDisclosure": true
      },
      "memory": {
        "type": "in-memory",
        "window": 20
      },
      "tools": [
        {
          "name": "find-pets-by-status",
          "description": "Finds Pets by status.",
          "params": [
            {
              "name": "status",
              "type": "string",
              "required": true,
              "description": "Status values that need to be considered for filter. One of: available, pending, sold."
            }
          ],
          "type": "http",
          "method": "GET",
          "url": "https://petstore3.swagger.io/api/v3/pet/findByStatus",
          "auth": {
            "type": "bearer",
            "env": "PETSTORE_TOKEN"
          }
        },
        {
          "name": "get-pet-by-id",
          "description": "Find pet by ID.",
          "params": [
            {
              "name": "petId",
              "type": "integer",
              "required": true,
              "description": "ID of pet to return"
            }
          ],
          "type": "http",
          "method": "GET",
          "url": "https://petstore3.swagger.io/api/v3/pet/{petId}",
          "auth": {
            "type": "header",
            "name": "api_key",
            "env": "PETSTORE_API_KEY"
          }
        }
      ],
      "interface": [
        "rest"
      ]
    }
  },
