  "config": {
    "agent": {
      "name": "hr-assistant",
      "description": "Tells employees how many days off they have left and books them",
      "profile": "standard",
      "java": 21,
      "build": "maven",
      "springAi": "2.0.1",
      "model": {
        "provider": "ollama",
        "name": "qwen2.5:7b",
        "temperature": 0
      },
      "prompt": {
        "system": "prompts/system.md",
        "aiDisclosure": true
      },
      "memory": {
        "window": 20,
        "type": "jdbc"
      },
      "tools": [
        {
          "name": "remaining-days-off",
          "description": "Days off the signed-in employee has left this year",
          "params": [],
          "type": "java"
        },
        {
          "name": "book-day-off",
          "description": "Books a day off for the signed-in employee",
          "params": [
            {
              "name": "date",
              "type": "string",
              "required": true,
              "description": "the day off, written YYYY-MM-DD"
            }
          ],
          "approval": {
            "required": true
          },
          "type": "java"
        }
      ],
      "interface": [
        "rest",
        "chat-ui"
      ],
      "security": {
        "auth": "oidc",
        "rateLimit": "30/min",
        "tokenBudget": "100000/day"
      },
      "cache": {
        "exact": "redis"
      },
      "observability": {
        "otel": true,
        "metrics": "prometheus"
      },
      "deploy": [
        "docker-compose"
      ]
    }
  },
