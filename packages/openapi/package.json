{
  "name": "@gen-agent/openapi",
  "version": "0.0.0",
  "private": true,
  "description": "gen-agent OpenAPI import: operations of an API become HTTP tools of an agent",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.include='src/**/*.ts' --coverage.reporter=text-summary --coverage.reporter=lcov --coverage.reporter=json-summary"
  },
  "dependencies": {
    "@gen-agent/core": "workspace:*",
    "yaml": "^2.9.1"
  }
}
