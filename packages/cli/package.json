{
  "name": "gen-agent",
  "version": "0.1.0",
  "description": "Describe your agent, get a production-ready Spring AI project.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "gen-agent": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "spring-ai",
    "spring-boot",
    "agent",
    "generator",
    "llm",
    "java"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --noEmit -p tsconfig.build.json && esbuild src/bin.ts --bundle --platform=node --format=esm --target=node22 --external:@clack/prompts --external:commander --external:ejs --external:prettier --external:prettier-plugin-java --external:yaml --external:zod --outfile=dist/bin.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "ejs": "^7.0.2",
    "prettier": "^3.9.10",
    "prettier-plugin-java": "^2.11.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gen-agent/core": "workspace:*",
    "@gen-agent/templates": "workspace:*",
    "esbuild": "^0.28.2"
  }
}
