{
  "name": "@gen-agent/templates",
  "version": "0.0.0",
  "private": true,
  "description": "gen-agent templates of the generated Spring AI project",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "references"
  ],
  "scripts": {
    "build": "node scripts/embed-templates.js && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.include='src/**/*.ts' --coverage.exclude=src/minimal-sources.ts --coverage.reporter=text-summary --coverage.reporter=lcov --coverage.reporter=json-summary"
  },
  "dependencies": {
    "@gen-agent/core": "workspace:*"
  }
}
