<%_ const askModel = (message, key) => limits.tokens
  ? `${type('org.springframework.ai.chat.model.ChatResponse')} response = chatClient
                .prompt()
                .user(${message})
                .advisors(advisor -> advisor.param(${type('org.springframework.ai.chat.memory.ChatMemory')}.CONVERSATION_ID, ${key}))
                .call()
                .chatResponse();
        usageLimits.recordTokens(userId, response.getMetadata().getUsage().getTotalTokens());
        String answer = response.getResult().getOutput().getText();`
  : `String answer = chatClient
                .prompt()
                .user(${message})
                .advisors(advisor -> advisor.param(${type('org.springframework.ai.chat.memory.ChatMemory')}.CONVERSATION_ID, ${key}))
                .call()
                .content();`;
const checkAnswer = features.outputGuard ? `
        // Checked before anything else sees it: the caches, the user.
        answer = guardrails.check(answer);` : ''; _%>
<%_ if (features.oidc) { _%>
    ChatMessageResponse reply(ChatMessageRequest request, String userId) {
<%_   if (features.limits) { _%>
        usageLimits.checkRequest(userId);
<%_   } _%>
        String conversationId = request.conversationId() != null
                ? request.conversationId()
                : <%= type('java.util.UUID') %>.randomUUID().toString();
        // Stored under a key of its user: another user's conversation id leads nowhere. A name-based UUID keeps the
        // key within the 36 characters of Spring AI's memory table.
        String memoryKey = UUID.nameUUIDFromBytes((userId + ":" + conversationId).getBytes(<%= type('java.nio.charset.StandardCharsets') %>.UTF_8)).toString();
        if (request.conversationId() != null && chatMemory.get(memoryKey).isEmpty()) {
            throw new UnknownConversationException(conversationId);
        }
<%_   if (features.injectionDetection) { _%>
        <%= type('java.util.Optional') %><String> refusal = guardrails.refusalFor(request.message());
        if (refusal.isPresent()) {
            return new ChatMessageResponse(conversationId, refusal.get());
        }
<%_   } _%>
<%_   if (features.pii) { _%>
        // The model, the memory and the caches only ever see tokens in place of personal data.
        String message = personalData.mask(memoryKey, request.message());
<%_   } else { _%>
        String message = request.message();
<%_   } _%>
<%_   if (features.erasure || features.retention) { _%>
        conversations.touch(memoryKey, userId);
<%_   } _%>
<%_   if (features.cache) { _%>
        boolean firstMessage = request.conversationId() == null;
        if (firstMessage) {
            <%= type('java.util.Optional') %><String> cached = replyCache.find(userId, message)<%= features.semanticCache ? '.or(() -> semanticCache.find(userId, message))' : '' %>;
            if (cached.isPresent()) {
                // Kept in the conversation as if the model had answered, so that it can go on from there.
                chatMemory.add(memoryKey, <%= type('java.util.List') %>.of(new <%= type('org.springframework.ai.chat.messages.UserMessage') %>(message), new <%= type('org.springframework.ai.chat.messages.AssistantMessage') %>(cached.get())));
                return new ChatMessageResponse(conversationId, cached.get());
            }
        }
<%_   } _%>
<%_   if (features.guardTools) { _%>
        toolGuard.start(<%= features.pii ? 'memoryKey' : '' %>);
<%_   } _%>
        <%- askModel('message', 'memoryKey') %><%- checkAnswer %>
<%_   if (features.cache) { _%>
<%_     const reasons = [...(features.trackToolCalls ? ['!toolGuard.toolCalled()'] : []), ...(features.pii ? ['!PersonalData.containsTokens(message)', '!PersonalData.containsTokens(answer)'] : [])]; _%>
<%_     if (reasons.length > 0) { _%>
        // Never reused: an answer built from a tool depends on live data, and one about personal data is about someone.
<%_     } _%>
        if (<%- ['firstMessage', ...reasons].join(' && ') %>) {
            replyCache.put(userId, message, answer);
<%_     if (features.semanticCache) { _%>
            semanticCache.put(userId, message, answer);
<%_     } _%>
        }
<%_   } _%>
<%_   if (features.pii) { _%>
        return new ChatMessageResponse(conversationId, personalData.restore(memoryKey, answer));
<%_   } else { _%>
        return new ChatMessageResponse(conversationId, answer);
<%_   } _%>
    }
<%_ } else { _%>
    ChatMessageResponse reply(ChatMessageRequest request) {
        String conversationId = request.conversationId() != null
                ? request.conversationId()
                : <%= type('java.util.UUID') %>.randomUUID().toString();
<%_   if (features.injectionDetection) { _%>
        <%= type('java.util.Optional') %><String> refusal = guardrails.refusalFor(request.message());
        if (refusal.isPresent()) {
            return new ChatMessageResponse(conversationId, refusal.get());
        }
<%_   } _%>
<%_   if (features.pii) { _%>
        String message = personalData.mask(conversationId, request.message());
<%_   } else { _%>
        String message = request.message();
<%_   } _%>
<%_   if (features.retention) { _%>
        conversations.touch(conversationId, "");
<%_   } _%>
<%_   if (features.guardTools) { _%>
        toolGuard.start(<%= features.pii ? 'conversationId' : '' %>);
<%_   } _%>
        <%- askModel('message', 'conversationId') %><%- checkAnswer %>
<%_   if (features.pii) { _%>
        return new ChatMessageResponse(conversationId, personalData.restore(conversationId, answer));
<%_   } else { _%>
        return new ChatMessageResponse(conversationId, answer);
<%_   } _%>
    }
<%_ } _%>
}
