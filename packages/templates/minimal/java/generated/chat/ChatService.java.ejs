<%_ } _%>
<%_ if (features.erasure || features.retention) { _%>

    private final <%= type(`${project.generatedPackage}.privacy.Conversations`) %> conversations;
<%_ } _%>
<%_ if (features.injectionDetection || features.outputGuard) { _%>

    private final <%= type(`${project.generatedPackage}.guard.Guardrails`) %> guardrails;
<%_ } _%>

    ChatService(<%- [
      'ChatClient chatClient',
      ...(features.oidc ? ['ChatMemory chatMemory'] : []),
      ...(features.limits ? ['UsageLimits usageLimits'] : []),
      ...(features.cache ? ['ReplyCache replyCache'] : []),
      ...(features.guardTools ? ['ToolGuard toolGuard'] : []),
      ...(features.semanticCache ? ['SemanticCache semanticCache'] : []),
      ...(features.pii ? ['PersonalData personalData'] : []),
      ...(features.erasure || features.retention ? ['Conversations conversations'] : []),
      ...(features.injectionDetection || features.outputGuard ? ['Guardrails guardrails'] : []),
