// Managed by gen-agent: changes here are overwritten.
package <%= project.generatedPackage %>.chat;

<%- imports %>

<%_ if (features.oidc) { _%>
/**
 * Sends a user message to the model within its conversation, so earlier messages are remembered. Conversations are
 * kept under their user: nobody can read or continue someone else's.
 */
<%_ } else { _%>
/** Sends a user message to the model within its conversation, so earlier messages are remembered. */
<%_ } _%>
@<%= type('org.springframework.stereotype.Service') %>
class ChatService {

    private final <%= type('org.springframework.ai.chat.client.ChatClient') %> chatClient;
<%_ if (features.oidc) { _%>

    private final <%= type('org.springframework.ai.chat.memory.ChatMemory') %> chatMemory;
<%_ } _%>
<%_ if (features.limits) { _%>

    private final <%= type(`${project.generatedPackage}.limits.UsageLimits`) %> usageLimits;
<%_ } _%>
<%_ if (features.cache) { _%>

    private final <%= type(`${project.generatedPackage}.cache.ReplyCache`) %> replyCache;
<%_ } _%>
<%_ if (features.trackToolCalls) { _%>

    private final <%= type(`${project.generatedPackage}.tool.ToolCalls`) %> toolCalls;
<%_ } _%>

    ChatService(<%- [
      'ChatClient chatClient',
      ...(features.oidc ? ['ChatMemory chatMemory'] : []),
      ...(features.limits ? ['UsageLimits usageLimits'] : []),
      ...(features.cache ? ['ReplyCache replyCache'] : []),
      ...(features.trackToolCalls ? ['ToolCalls toolCalls'] : []),
    ].join(', ') %>) {
        this.chatClient = chatClient;
<%_ if (features.oidc) { _%>
        this.chatMemory = chatMemory;
<%_ } _%>
<%_ if (features.limits) { _%>
        this.usageLimits = usageLimits;
<%_ } _%>
<%_ if (features.cache) { _%>
        this.replyCache = replyCache;
<%_ } _%>
<%_ if (features.trackToolCalls) { _%>
        this.toolCalls = toolCalls;
<%_ } _%>
    }

<%_ if (features.oidc) { _%>
    ChatMessageResponse reply(ChatMessageRequest request, String userId) {
<%_   if (features.limits) { _%>
        usageLimits.checkRequest(userId);
<%_   } _%>
        String conversationId = request.conversationId() != null
                ? request.conversationId()
                : <%= type('java.util.UUID') %>.randomUUID().toString();
        // Stored under a key of its user: another user's conversation id leads nowhere. A name-based UUID keeps the
        // key within the 36 characters of Spring AI's memory table.
        String memoryKey = UUID.nameUUIDFromBytes((userId + ":" + conversationId).getBytes(<%= type('java.nio.charset.StandardCharsets') %>.UTF_8)).toString();
        if (request.conversationId() != null && chatMemory.get(memoryKey).isEmpty()) {
            throw new UnknownConversationException(conversationId);
        }
<%_   if (features.cache) { _%>
        boolean firstMessage = request.conversationId() == null;
        if (firstMessage) {
            <%= type('java.util.Optional') %><String> cached = replyCache.find(userId, request.message());
            if (cached.isPresent()) {
                // Kept in the conversation as if the model had answered, so that it can go on from there.
                chatMemory.add(memoryKey, <%= type('java.util.List') %>.of(new <%= type('org.springframework.ai.chat.messages.UserMessage') %>(request.message()), new <%= type('org.springframework.ai.chat.messages.AssistantMessage') %>(cached.get())));
                return new ChatMessageResponse(conversationId, cached.get());
            }
        }
<%_   } _%>
<%_   if (features.trackToolCalls) { _%>
        toolCalls.start();
<%_   } _%>
<%_   if (limits.tokens) { _%>
        <%= type('org.springframework.ai.chat.model.ChatResponse') %> response = chatClient
                .prompt()
                .user(request.message())
                .advisors(advisor -> advisor.param(ChatMemory.CONVERSATION_ID, memoryKey))
                .call()
                .chatResponse();
        usageLimits.recordTokens(userId, response.getMetadata().getUsage().getTotalTokens());
        String reply = response.getResult().getOutput().getText();
<%_   } else { _%>
        String reply = chatClient
                .prompt()
                .user(request.message())
                .advisors(advisor -> advisor.param(ChatMemory.CONVERSATION_ID, memoryKey))
                .call()
                .content();
<%_   } _%>
<%_   if (features.cache && features.trackToolCalls) { _%>
        // An answer built from a tool depends on live data: it is never reused.
        if (firstMessage && !toolCalls.happened()) {
            replyCache.put(userId, request.message(), reply);
        }
<%_   } else if (features.cache) { _%>
        if (firstMessage) {
            replyCache.put(userId, request.message(), reply);
        }
<%_   } _%>
        return new ChatMessageResponse(conversationId, reply);
    }
<%_ } else { _%>
    ChatMessageResponse reply(ChatMessageRequest request) {
        String conversationId = request.conversationId() != null
                ? request.conversationId()
                : <%= type('java.util.UUID') %>.randomUUID().toString();
        String reply = chatClient
                .prompt()
                .user(request.message())
                .advisors(advisor -> advisor.param(<%= type('org.springframework.ai.chat.memory.ChatMemory') %>.CONVERSATION_ID, conversationId))
                .call()
                .content();
        return new ChatMessageResponse(conversationId, reply);
    }
<%_ } _%>
}
