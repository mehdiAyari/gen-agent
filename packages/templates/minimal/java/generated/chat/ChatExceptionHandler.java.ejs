// Managed by gen-agent: changes here are overwritten.
package <%= project.generatedPackage %>.chat;

<%- imports %>

/**
 * Answers every error as an RFC 9457 problem detail. Spring MVC errors (validation…) keep their status; anything else
 * becomes a generic 500 whose details stay in the logs, never in the response.
 */
@<%= type('org.springframework.web.bind.annotation.RestControllerAdvice') %>
class ChatExceptionHandler extends <%= type('org.springframework.web.servlet.mvc.method.annotation.ResponseEntityExceptionHandler') %> {

    private static final <%= type('org.slf4j.Logger') %> log = <%= type('org.slf4j.LoggerFactory') %>.getLogger(ChatExceptionHandler.class);

<%_ if (features.oidc) { _%>
    @<%= type('org.springframework.web.bind.annotation.ExceptionHandler') %>
    <%= type('org.springframework.http.ProblemDetail') %> handleUnknownConversation(UnknownConversationException exception) {
        ProblemDetail problem = ProblemDetail.forStatusAndDetail(
                <%= type('org.springframework.http.HttpStatus') %>.NOT_FOUND, "No such conversation: start a new one without conversationId.");
        problem.setTitle("Unknown conversation");
        return problem;
    }

<%_ } _%>
<%_ if (features.limits) { _%>
    @<%= type('org.springframework.web.bind.annotation.ExceptionHandler') %>
    <%= type('org.springframework.http.ResponseEntity') %><<%= type('org.springframework.http.ProblemDetail') %>> handleLimitExceeded(<%= type(`${project.generatedPackage}.limits.LimitExceededException`) %> exception) {
        ProblemDetail problem = ProblemDetail.forStatusAndDetail(<%= type('org.springframework.http.HttpStatus') %>.TOO_MANY_REQUESTS, exception.getMessage());
        problem.setTitle("Limit reached");
        // Whole seconds, rounded up: a client that waits this long is served.
        long seconds = Math.max(1, exception.retryAfter().toSeconds() + (exception.retryAfter().toNanosPart() > 0 ? 1 : 0));
        return ResponseEntity.status(HttpStatus.TOO_MANY_REQUESTS)
                .header(<%= type('org.springframework.http.HttpHeaders') %>.RETRY_AFTER, String.valueOf(seconds))
                .body(problem);
    }

<%_ } _%>
<%_ if (features.requestTimeout) { _%>
    @<%= type('org.springframework.web.bind.annotation.ExceptionHandler') %>
    <%= type('org.springframework.http.ProblemDetail') %> handleTimeout(<%= type(`${project.generatedPackage}.guard.RequestTimeoutException`) %> exception) {
        ProblemDetail problem = ProblemDetail.forStatusAndDetail(<%= type('org.springframework.http.HttpStatus') %>.GATEWAY_TIMEOUT, exception.getMessage());
        problem.setTitle("Too slow");
        return problem;
    }

<%_ } _%>
<%_ if (loop.maxIterations !== undefined && (tools.length > 0 || features.mcp)) { _%>
    @<%= type('org.springframework.web.bind.annotation.ExceptionHandler') %>
    <%= type('org.springframework.http.ProblemDetail') %> handleToolCallLimit(<%= type('org.springframework.ai.model.tool.ToolCallLimitExceededException') %> exception) {
        ProblemDetail problem = ProblemDetail.forStatusAndDetail(
                <%= type('org.springframework.http.HttpStatus') %>.UNPROCESSABLE_CONTENT,
                "The agent needed more than " + exception.getLimit() + " tool calls to answer. Ask something narrower.");
        problem.setTitle("Too many tool calls");
        return problem;
    }

<%_ } _%>
<%_ if (features.approval) { _%>
    @<%= type('org.springframework.web.bind.annotation.ExceptionHandler') %>
    <%= type('org.springframework.http.ProblemDetail') %> handleApprovalUnavailable(<%= type(`${project.generatedPackage}.approval.ApprovalUnavailableException`) %> exception) {
        ProblemDetail problem = ProblemDetail.forStatusAndDetail(exception.status(), exception.getMessage());
        problem.setTitle("Approval unavailable");
        return problem;
    }

<%_ } _%>
<%_ if (features.killSwitches) { _%>
    @<%= type('org.springframework.web.bind.annotation.ExceptionHandler') %>
    <%= type('org.springframework.http.ProblemDetail') %> handleSwitchedOff(<%= type(`${project.generatedPackage}.switches.AgentSwitchedOffException`) %> exception) {
        ProblemDetail problem = ProblemDetail.forStatusAndDetail(<%= type('org.springframework.http.HttpStatus') %>.SERVICE_UNAVAILABLE, exception.getMessage());
        problem.setTitle("Switched off");
        return problem;
    }

<%_ } _%>
    /** Says which field is wrong and why: "message: must not be blank". */
    @Override
    protected <%= type('org.springframework.http.ResponseEntity') %><Object> handleMethodArgumentNotValid(
            <%= type('org.springframework.web.bind.MethodArgumentNotValidException') %> exception,
            <%= type('org.springframework.http.HttpHeaders') %> headers,
            <%= type('org.springframework.http.HttpStatusCode') %> status,
            <%= type('org.springframework.web.context.request.WebRequest') %> request) {
        exception.getBody().setDetail(exception.getFieldErrors().stream()
                .map(error -> error.getField() + ": " + error.getDefaultMessage())
                .sorted()
                .collect(<%= type('java.util.stream.Collectors') %>.joining("; ")));
        return super.handleMethodArgumentNotValid(exception, headers, status, request);
    }

<%_ if (features.postgres || features.redis) { _%>
    /** A database the agent needs is down or too slow: the client may try again soon, and learns nothing more. */
    @<%= type('org.springframework.web.bind.annotation.ExceptionHandler') %>({<%= type('org.springframework.dao.DataAccessResourceFailureException') %>.class, <%= type('org.springframework.dao.QueryTimeoutException') %>.class})
    <%= type('org.springframework.http.ResponseEntity') %><<%= type('org.springframework.http.ProblemDetail') %>> handleUnavailable(<%= type('org.springframework.dao.DataAccessException') %> exception) {
        log.warn("A service the agent needs is unavailable: {}", exception.getMessage());
        ProblemDetail problem = ProblemDetail.forStatusAndDetail(
                <%= type('org.springframework.http.HttpStatus') %>.SERVICE_UNAVAILABLE, "A service the agent needs is unavailable. Try again in a moment.");
        problem.setTitle("Temporarily unavailable");
        return ResponseEntity.status(HttpStatus.SERVICE_UNAVAILABLE)
                .header(<%= type('org.springframework.http.HttpHeaders') %>.RETRY_AFTER, "30")
                .body(problem);
    }

<%_ } _%>
    @<%= type('org.springframework.web.bind.annotation.ExceptionHandler') %>(Exception.class)
    <%= type('org.springframework.http.ProblemDetail') %> handleUnexpected(Exception exception) {
        log.error("The agent could not answer", exception);
        ProblemDetail problem = ProblemDetail.forStatusAndDetail(
                <%= type('org.springframework.http.HttpStatus') %>.INTERNAL_SERVER_ERROR, "The agent could not answer. Try again later.");
        problem.setTitle("Agent error");
        return problem;
    }
}
