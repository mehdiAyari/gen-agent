// Managed by gen-agent: changes here are overwritten.
package <%= project.generatedPackage %>.security;

<%- imports %>

/**
 * Every request needs a JWT from the OIDC issuer of {@code application.yml}. No session and no cookie: the token is
 * sent with each request, so there is nothing for a cross-site request to forge.
 */
@<%= type('org.springframework.context.annotation.Configuration') %>(proxyBeanMethods = false)
public class SecurityConfiguration {

<%_ if (features.chatUi) { _%>
    /** The chat page and its settings are public; the page talks only to the agent and to the OIDC provider. */
    private static final String[] CHAT_PAGE = {"/", "/index.html", "/chat.js", "/chat.css", "/chat-config.json"};

    @<%= type('org.springframework.context.annotation.Bean') %>
    <%= type('org.springframework.security.web.SecurityFilterChain') %> securityFilterChain(
            <%= type('org.springframework.security.config.annotation.web.builders.HttpSecurity') %> http,
            @<%= type('org.springframework.beans.factory.annotation.Value') %>("${spring.security.oauth2.resourceserver.jwt.issuer-uri}") String issuer)
            throws Exception {
        <%= type('java.net.URI') %> provider = URI.create(issuer);
        String providerOrigin = provider.getScheme() + "://" + provider.getAuthority();
<%_ } else { _%>
    @<%= type('org.springframework.context.annotation.Bean') %>
    <%= type('org.springframework.security.web.SecurityFilterChain') %> securityFilterChain(<%= type('org.springframework.security.config.annotation.web.builders.HttpSecurity') %> http) throws Exception {
<%_ } _%>
        return http.authorizeHttpRequests(requests -> requests<%_ if (features.otel || features.prometheus) { _%>
                        // Health and metrics are served on the management port only, which stays inside the network.
                        .requestMatchers(<%- ['"/actuator/health"', ...(features.prometheus ? ['"/actuator/prometheus"'] : [])].join(', ') %>)
                        .permitAll()<%_ } _%><%_ if (features.chatUi) { _%>
                        .requestMatchers(CHAT_PAGE)
                        .permitAll()<%_ } _%>
                        .anyRequest()
                        .authenticated())
                .oauth2ResourceServer(server -> server.jwt(<%= type('org.springframework.security.config.Customizer') %>.withDefaults()))
                .sessionManagement(session -> session.sessionCreationPolicy(<%= type('org.springframework.security.config.http.SessionCreationPolicy') %>.STATELESS))
                .csrf(<%= type('org.springframework.security.config.annotation.web.configurers.AbstractHttpConfigurer') %>::disable)<%_ if (features.chatUi) { _%>
                .headers(headers -> headers.contentSecurityPolicy(csp -> csp.policyDirectives(
                        "default-src 'self'; img-src 'self' data:; connect-src 'self' " + providerOrigin
                                + "; frame-ancestors 'none'; form-action 'self' " + providerOrigin)))<%_ } _%>
                .build();
    }
}
