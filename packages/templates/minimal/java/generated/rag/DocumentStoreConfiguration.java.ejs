// Managed by gen-agent: changes here are overwritten.
package <%= project.generatedPackage %>.rag;

<%- imports %>

@<%= type('org.springframework.context.annotation.Configuration') %>(proxyBeanMethods = false)
class DocumentStoreConfiguration {

    /** Its own table, agent_document: the passages of the documents, compared by cosine distance. */
    @<%= type('org.springframework.context.annotation.Bean') %>
    <%= type('org.springframework.ai.vectorstore.pgvector.PgVectorStore') %> documentStore(
            <%= type('org.springframework.jdbc.core.JdbcTemplate') %> jdbcTemplate, <%= type('org.springframework.ai.embedding.EmbeddingModel') %> embeddingModel, <%= type(`${project.generatedPackage}.AgentProperties`) %> properties) {
        return PgVectorStore.builder(jdbcTemplate, embeddingModel)
                .vectorTableName("agent_document")
                .dimensions(properties.rag().dimensions())
                .distanceType(PgVectorStore.PgDistanceType.COSINE_DISTANCE)
                .indexType(PgVectorStore.PgIndexType.HNSW)
                .initializeSchema(true)
                .build();
    }
}
