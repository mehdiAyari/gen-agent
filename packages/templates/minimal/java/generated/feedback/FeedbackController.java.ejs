package <%= project.generatedPackage %>.feedback;

<%- imports %>

/** A thumb up or down on an answer, and why. */
@<%= type('org.springframework.web.bind.annotation.RestController') %>
@<%= type('org.springframework.web.bind.annotation.RequestMapping') %>("/api/feedback")
class FeedbackController {

    /**
     * @param conversationId the conversation of the answer
     * @param rating UP or DOWN
     * @param comment what was wrong or right, optional
     */
    record FeedbackRequest(
            @<%= type('jakarta.validation.constraints.NotBlank') %> String conversationId,
            @<%= type('jakarta.validation.constraints.NotNull') %> Feedbacks.Rating rating,
            @<%= type('jakarta.validation.constraints.Size') %>(max = 2000) String comment) {}

    private final Feedbacks feedbacks;
<%_ if (features.oidc) { _%>

    private final <%= type(`${project.generatedPackage}.chat.ChatService`) %> chatService;
<%_ } _%>
<%_ if (features.pii) { _%>

    private final <%= type(`${project.generatedPackage}.privacy.PersonalData`) %> personalData;
<%_ } _%>

    FeedbackController(<%- ['Feedbacks feedbacks', ...(features.oidc ? ['ChatService chatService'] : []), ...(features.pii ? ['PersonalData personalData'] : [])].join(', ') %>) {
        this.feedbacks = feedbacks;
<%_ if (features.oidc) { _%>
        this.chatService = chatService;
<%_ } _%>
<%_ if (features.pii) { _%>
        this.personalData = personalData;
<%_ } _%>
    }

    @<%= type('org.springframework.web.bind.annotation.PostMapping') %>
    @<%= type('org.springframework.web.bind.annotation.ResponseStatus') %>(<%= type('org.springframework.http.HttpStatus') %>.NO_CONTENT)
    void rate(@<%= type('jakarta.validation.Valid') %> @<%= type('org.springframework.web.bind.annotation.RequestBody') %> FeedbackRequest request<%- features.oidc ? `, @${type('org.springframework.security.core.annotation.AuthenticationPrincipal')} ${type('org.springframework.security.oauth2.jwt.Jwt')} user` : '' %>) {
<%_ if (features.oidc) { _%>
        // Only on a conversation of the user: anyone else's, or one that never was, answers 404.
        chatService.requireConversation(user.getSubject(), request.conversationId());
<%_ } _%>
<%_ if (features.pii) { _%>
        // The comment is kept with its personal data masked, under a key of its own.
        String comment = request.comment() == null ? null : personalData.mask("feedback:" + request.conversationId(), request.comment());
<%_ } else { _%>
        String comment = request.comment();
<%_ } _%>
        feedbacks.record(<%= features.oidc ? 'user.getSubject()' : '"anonymous"' %>, request.conversationId(), request.rating(), comment);
    }
}
