// Managed by gen-agent: changes here are overwritten. Set the duration in application.yml.
package <%= project.generatedPackage %>.cache;

<%- imports %>

/**
 * Reuses the first answer of a conversation when the same user asks the same question again, without calling the
 * model. The key holds the user, the model and the system prompt: an answer never reaches another user, and a new
 * prompt or model starts afresh.
 */
@<%= type('org.springframework.stereotype.Component') %>
public class ReplyCache {

    private final <%= type('org.springframework.data.redis.core.StringRedisTemplate') %> redis;

    private final <%= type('java.time.Duration') %> ttl;

    private final String context;

    ReplyCache(
            StringRedisTemplate redis,
            <%= type(`${project.generatedPackage}.AgentProperties`) %> properties,
            @<%= type('org.springframework.beans.factory.annotation.Value') %>("${<%= provider.propertyPrefix %>.chat.model}") String model) {
        this.redis = redis;
        this.ttl = properties.cache().ttl();
        try {
            this.context = model + "\n" + properties.systemPrompt().getContentAsString(<%= type('java.nio.charset.StandardCharsets') %>.UTF_8);
        } catch (<%= type('java.io.IOException') %> exception) {
            throw new <%= type('java.io.UncheckedIOException') %>("Cannot read the system prompt", exception);
        }
    }

    public <%= type('java.util.Optional') %><String> find(String userId, String question) {
        return Optional.ofNullable(redis.opsForValue().get(key(userId, question)));
    }

    public void put(String userId, String question, String answer) {
        redis.opsForValue().set(key(userId, question), answer, ttl);
    }

<%_ if (features.erasure) { _%>
    public void forget(String userId) {
        // SCAN rather than KEYS: Redis keeps serving the other users meanwhile.
        try (<%= type('org.springframework.data.redis.core.Cursor') %><String> keys = redis.scan(<%= type('org.springframework.data.redis.core.ScanOptions') %>.scanOptions().match(prefix(userId) + "*").build())) {
            keys.forEachRemaining(redis::delete);
        }
    }

<%_ } _%>
    /** Questions that differ only by case or spacing share their answer. */
    private String key(String userId, String question) {
        String normalized = question.strip().replaceAll("\\s+", " ").toLowerCase(<%= type('java.util.Locale') %>.ROOT);
        return prefix(userId) + <%= type('java.util.HexFormat') %>.of().formatHex(sha256(context + "\n" + normalized));
    }

    /** Every answer of a user starts with it, without the user id itself. */
    private static String prefix(String userId) {
        return "reply:" + HexFormat.of().formatHex(sha256(userId)) + ":";
    }

    private static byte[] sha256(String text) {
        try {
            return <%= type('java.security.MessageDigest') %>.getInstance("SHA-256").digest(text.getBytes(StandardCharsets.UTF_8));
        } catch (<%= type('java.security.NoSuchAlgorithmException') %> exception) {
            throw new IllegalStateException("SHA-256 is part of every Java runtime", exception);
        }
    }
}
