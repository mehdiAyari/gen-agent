spring:
  application:
    name: <%= project.artifactId %>
<%_ if (features.postgres) { _%>
  datasource:
    url: ${DATABASE_URL:jdbc:postgresql://localhost:5432/agent}
    username: ${DATABASE_USERNAME:agent}
    password: ${DATABASE_PASSWORD}
<%_ } _%>
<%_ if (features.redis) { _%>
  data:
    redis:
      url: ${REDIS_URL:redis://localhost:6379}
<%_ } _%>
<%_ if (features.rag && features.oidc) { _%>
  servlet:
    multipart:
      # The largest document an administrator may upload.
      max-file-size: 20MB
      max-request-size: 20MB
<%_ } _%>
<%_ if (features.oidc) { _%>
  security:
    oauth2:
      resourceserver:
        jwt:
          # Only tokens of this issuer are accepted; its keys are found through its OIDC discovery document.
          issuer-uri: ${OIDC_ISSUER_URI}
<%_ } _%>
  ai:
    <%= provider.configKey %>:
<%_ if (provider.apiKeyEnv) { _%>
      api-key: ${<%= provider.apiKeyEnv %>}
<%_ } _%>
      chat:
        model: <%= yamlString(provider.model) %>
<%_ if (provider.temperature !== undefined) { _%>
        temperature: <%= provider.temperature %>
<%_ } _%>
<%_ if (provider.maxTokens !== undefined) { _%>
        <%= provider.maxTokensProperty %>: <%= provider.maxTokens %>
<%_ } _%>
<%_ if (embedding) { _%>
      embedding:
        model: <%= embedding.model %>
<%_ } _%>
<%_ if (features.resilience && provider.retries === 'sdk') { _%>
      # Failed calls are retried twice, with a growing delay, before the circuit breaker counts a failure.
      max-retries: 2
<%_ } _%>
<%_ if (features.resilience && provider.retries === 'spring') { _%>
    retry:
      # Failed calls are retried twice, 1 then 2 seconds apart, before the circuit breaker counts a failure.
      max-attempts: 3
      backoff:
        initial-interval: 1s
        multiplier: 2
        max-interval: 4s
<%_ } _%>
<%_ if (features.mcp) { _%>
    mcp:
      client:
        stdio:
          connections:
<%_   for (const server of mcpServers) { _%>
            <%= server.name %>:
              command: <%= server.command %>
              args:
<%_     for (const arg of server.args) { _%>
                - <%= yamlString(arg) %>
<%_     } _%>
<%_     if (server.env.length > 0) { _%>
              env:
<%_       for (const name of server.env) { _%>
                <%= name %>: ${<%= name %>}
<%_       } _%>
<%_     } _%>
<%_   } _%>
<%_ } _%>
<%_ if (loop.maxIterations !== undefined) { _%>
    tools:
      limits:
        # Tool calls the model may make to answer one message; beyond, the request stops with 422.
        max-total-tool-calls: <%= loop.maxIterations %>
<%_ } _%>
<%_ if (features.jdbcMemory) { _%>
    chat:
      memory:
        repository:
          jdbc:
            # Creates the table of Spring AI's chat memory when it does not exist yet.
            initialize-schema: always
<%_ } _%>

<%_ if (features.resilience) { _%>
resilience4j:
  circuitbreaker:
    configs:
      default:
        # Open after half of the last 10 calls failed (5 at least), then try again after 30 seconds.
        sliding-window-size: 10
        minimum-number-of-calls: 5
        failure-rate-threshold: 50
        wait-duration-in-open-state: 30s
        permitted-number-of-calls-in-half-open-state: 2

<%_ } _%>
agent:
  system-prompt: classpath:<%= prompt.resource %>
<%_ if (features.resilience) { _%>
  # Sent when no model can answer.
  fallback-answer: "The assistant is unavailable right now. Please try again in a few minutes."
<%_ } _%>
<%_ if (fallback) { _%>
  fallback:
    model: <%= yamlString(fallback.model) %>
<%_   if (fallback.apiKeyEnv) { _%>
    api-key: ${<%= fallback.apiKeyEnv %>}
<%_   } _%>
<%_   if (fallback.provider === 'ollama' && !fallback.sameProvider) { _%>
    base-url: ${AGENT_FALLBACK_BASE_URL:http://localhost:11434}
<%_   } _%>
<%_ } _%>
<%_ if (features.rag) { _%>
  rag:
    # Indexed at startup: new and changed files only.
    documents: ${AGENT_RAG_DOCUMENTS:documents}
    # Passages sent with each question, and their size in tokens.
    top-k: <%= rag.topK %>
    chunk-size: <%= rag.chunkSize %>
    dimensions: <%= embedding.dimensions %>
<%_ } _%>
<%_ if (routing) { _%>
  routing:
    # Simple messages go to the first model, the others to the second.
    simple: <%= yamlString(routing.simple) %>
    complex: <%= yamlString(routing.complex) %>
<%_ } _%>
<%_ if (features.requestTimeout) { _%>
  # The longest a request may take, model calls and tools included; beyond, 504.
  timeout: <%= loop.timeout %>
<%_ } _%>
<%_ if (features.injectionDetection || features.outputGuard) { _%>
  guard:
    # Sent instead of an answer to a message that tries to take over the agent, or that would leak its instructions.
    refusal: "I can't help with that request."
<%_ } _%>
<%_ if (features.adminRole) { _%>
  security:
    # Where the roles are in the tokens of the provider: agent-admin is the administrator of the agent.
    roles-claim: ${OIDC_ROLES_CLAIM:realm_access.roles}
<%_ } _%>
<%_ if (features.chatUi && features.oidc) { _%>
  chat-ui:
    # Public client of the chat page at the OIDC provider: authorization code with PKCE, no secret.
    client-id: ${OIDC_CLIENT_ID:agent-client}
<%_ } _%>
  memory:
    window: <%= memory.window %>
<%_ if (features.retention) { _%>
    # Unused conversations are erased after this long (GDPR storage limitation).
    retention: <%= retention %>
<%_ } _%>
<%_ if (features.limits) { _%>
  limits:
<%_   if (limits.requests) { _%>
    requests: <%= limits.requests.capacity %>
    requests-period: <%= limits.requests.period %>
<%_   } _%>
<%_   if (limits.tokens) { _%>
    tokens: <%= limits.tokens.capacity %>
    tokens-period: <%= limits.tokens.period %>
<%_   } _%>
<%_ } _%>
<%_ if (features.httpTools) { _%>
  tools:
<%_   for (const tool of tools) { _%>
<%_     if (tool.kind === 'http') { _%>
    <%= tool.name %>:
      url: <%= yamlString(tool.url) %>
<%_       if (tool.auth) { _%>
      token: ${<%= tool.auth.env %>}
<%_       } _%>
      max-response-chars: <%= tool.maxResponseChars %>
<%_     } _%>
<%_   } _%>
<%_ } _%>
<%_ if (features.cache) { _%>
  cache:
    # How long a first answer is reused for the same question of the same user.
    ttl: 1h
<%_   if (features.semanticCache) { _%>
    semantic:
      # Questions of the same user this similar (0 to 1) share their answer.
      threshold: <%= semanticCache.threshold %>
      dimensions: <%= embedding.dimensions %>
<%_   } _%>
<%_ } _%>
<%_ if (features.pii) { _%>
  privacy:
    # How long the personal data behind the tokens of a conversation is kept.
    ttl: <%= retention ?? '30d' %>
<%_ } _%>
<%_ if (features.otel || features.prometheus) { _%>

management:
  server:
    # Health and metrics on their own port, kept off the public one.
    port: ${MANAGEMENT_PORT:8081}
  endpoints:
    web:
      exposure:
        include: <%= ['health', ...(features.prometheus ? ['prometheus'] : [])].join(', ') %>
<%_   if (features.otel) { _%>
  tracing:
    sampling:
      probability: 1.0
    export:
      otlp:
        # Sent to an OpenTelemetry collector when OTLP_ENABLED is true: docker compose starts one, with Grafana.
        enabled: ${OTLP_ENABLED:false}
  opentelemetry:
    tracing:
      export:
        otlp:
          endpoint: ${OTLP_ENDPOINT:http://localhost:4318}/v1/traces
  otlp:
    metrics:
      export:
        enabled: ${OTLP_ENABLED:false}
        url: ${OTLP_ENDPOINT:http://localhost:4318}/v1/metrics
<%_   } _%>
<%_ } _%>
