// Managed by gen-agent: changes here are overwritten.
package <%= project.generatedPackage %>.chat;

<%- imports %>
<%_
  const reply = features.oidc ? `reply(${staticImport('org.mockito.ArgumentMatchers.any')}(), ${staticImport('org.mockito.ArgumentMatchers.eq')}("ada"))` : `reply(${staticImport('org.mockito.ArgumentMatchers.any')}())`;
  const signedIn = features.oidc ? `\n                        .with(${staticImport('org.springframework.security.test.web.servlet.request.SecurityMockMvcRequestPostProcessors.jwt')}().jwt(token -> token.subject("ada")))` : '';
_%>

<%_ if (features.oidc) { _%>
@<%= type('org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest') %>(
        controllers = ChatController.class,
        properties = "spring.security.oauth2.resourceserver.jwt.issuer-uri=https://issuer.example.org")
@<%= type('org.springframework.context.annotation.Import') %>(<%= type(`${project.generatedPackage}.security.SecurityConfiguration`) %>.class)
<%_ } else { _%>
@<%= type('org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest') %>(ChatController.class)
<%_ } _%>
class ChatControllerTests {

    @<%= type('org.springframework.beans.factory.annotation.Autowired') %>
    <%= type('org.springframework.test.web.servlet.assertj.MockMvcTester') %> mockMvc;

    @<%= type('org.springframework.test.context.bean.override.mockito.MockitoBean') %>
    ChatService chatService;

    @<%= type('org.junit.jupiter.api.Test') %>
    void returnsTheReplyOfTheAgent() {
        <%= staticImport('org.mockito.BDDMockito.given') %>(chatService.<%- reply %>).willReturn(new ChatMessageResponse("c1", "Hi!"));

        <%= staticImport('org.assertj.core.api.Assertions.assertThat') %>(mockMvc.post()
                        .uri("/api/chat")<%- signedIn %>
                        .contentType(<%= type('org.springframework.http.MediaType') %>.APPLICATION_JSON)
                        .content("""
                                {"message": "Hello"}
                                """))
                .hasStatusOk()
                .bodyJson()
                .extractingPath("$.reply")
                .isEqualTo("Hi!");
    }

    @Test
    void rejectsABlankMessageWithAProblemDetail() {
        assertThat(mockMvc.post()
                        .uri("/api/chat")<%- signedIn %>
                        .contentType(MediaType.APPLICATION_JSON)
                        .content("""
                                {"message": " "}
                                """))
                .hasStatus(<%= type('org.springframework.http.HttpStatus') %>.BAD_REQUEST)
                .hasContentType(MediaType.APPLICATION_PROBLEM_JSON);
    }

    @Test
    void hidesInternalErrorsBehindAGenericProblemDetail() {
        given(chatService.<%- reply %>).willThrow(new IllegalStateException("connection refused to internal host"));

        assertThat(mockMvc.post()
                        .uri("/api/chat")<%- signedIn %>
                        .contentType(MediaType.APPLICATION_JSON)
                        .content("""
                                {"message": "Hello"}
                                """))
                .hasStatus(HttpStatus.INTERNAL_SERVER_ERROR)
                .hasContentType(MediaType.APPLICATION_PROBLEM_JSON)
                .bodyText()
                .doesNotContain("internal host");
    }
<%_ if (features.oidc) { _%>

    @Test
    void refusesRequestsWithoutAToken() {
        assertThat(mockMvc.post()
                        .uri("/api/chat")
                        .contentType(MediaType.APPLICATION_JSON)
                        .content("""
                                {"message": "Hello"}
                                """))
                .hasStatus(HttpStatus.UNAUTHORIZED);
    }

    @Test
    void answersNotFoundForAConversationOfSomeoneElse() {
        given(chatService.<%- reply %>).willThrow(new UnknownConversationException("c1"));

        assertThat(mockMvc.post()
                        .uri("/api/chat")<%- signedIn %>
                        .contentType(MediaType.APPLICATION_JSON)
                        .content("""
                                {"conversationId": "c1", "message": "Hello"}
                                """))
                .hasStatus(HttpStatus.NOT_FOUND)
                .hasContentType(MediaType.APPLICATION_PROBLEM_JSON);
    }
<%_ } _%>
<%_ if (features.limits) { _%>

    @Test
    void tellsWhenToComeBackOnceALimitIsReached() {
        given(chatService.<%- reply %>)
                .willThrow(new <%= type(`${project.generatedPackage}.limits.LimitExceededException`) %>("Too many requests", <%= type('java.time.Duration') %>.ofMillis(1500)));

        assertThat(mockMvc.post()
                        .uri("/api/chat")<%- signedIn %>
                        .contentType(MediaType.APPLICATION_JSON)
                        .content("""
                                {"message": "Hello"}
                                """))
                .hasStatus(HttpStatus.TOO_MANY_REQUESTS)
                .hasHeader(<%= type('org.springframework.http.HttpHeaders') %>.RETRY_AFTER, "2");
    }
<%_ } _%>
}
