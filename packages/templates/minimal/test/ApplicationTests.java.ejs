<%_   if (features.cache) { _%>
    @Test
    void answersARepeatedFirstQuestionFromTheCacheOfItsUser() {
        int calls = chatModel.calls();
<%_     if (routing?.strategy === 'classifier') { _%>
        // Each answer of the model takes two calls: the classifier of the routing, then the answer.
        int callsPerAnswer = 2;
<%_     } _%>

        assertThat(post("carol", """
                {"message": "What are your opening hours?"}
                """)).hasStatusOk();
        assertThat(post("carol", """
                {"message": "what are your   opening hours?"}
                """))
                .hasStatusOk()
                .bodyJson()
                .extractingPath("$.reply")
                .isEqualTo("Hello from the agent");
        assertThat(chatModel.calls()).isEqualTo(calls + <%= routing?.strategy === 'classifier' ? 'callsPerAnswer' : '1' %>);

        // Another user never gets it.
        post("dave", """
                {"message": "What are your opening hours?"}
                """);
        assertThat(chatModel.calls()).isEqualTo(calls + <%= routing?.strategy === 'classifier' ? '2 * callsPerAnswer' : '2' %>);
    }

