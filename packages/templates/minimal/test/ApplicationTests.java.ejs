    /** Answers every prompt with the same text and keeps the last prompt for assertions. */
    static class RecordingChatModel implements <%= type('org.springframework.ai.chat.model.ChatModel') %> {
<%_ if (limits.tokens) { _%>

        static final long TOKENS_PER_REPLY = 10;

        private volatile long tokensPerReply = TOKENS_PER_REPLY;
<%_ } _%>

        private volatile <%= type('org.springframework.ai.chat.prompt.Prompt') %> lastPrompt;
<%_ if (features.resilience) { _%>

        private volatile <%= type('java.util.function.Predicate') %><Prompt> failing = prompt -> false;
<%_ } _%>
<%_ if (features.cache) { _%>

        private final <%= type('java.util.concurrent.atomic.AtomicInteger') %> calls = new AtomicInteger();
<%_ } _%>

        @Override
        public <%= type('org.springframework.ai.chat.model.ChatResponse') %> call(Prompt prompt) {
            this.lastPrompt = prompt;
<%_ if (features.pii) { _%>
            // Like a real model, it gives back the tokens of personal data it was told about.
            String text = "Hello from the agent" + <%= type('java.util.regex.Pattern') %>.compile("\\[[A-Z]+_\\d+]")
                    .matcher(prompt.getUserMessage().getText())
                    .results()
                    .map(match -> " " + match.group())
                    .collect(<%= type('java.util.stream.Collectors') %>.joining());
<%_ } else { _%>
            String text = "Hello from the agent";
<%_ } _%>
<%_ if (features.resilience) { _%>
            if (failing.test(prompt)) {
                throw new IllegalStateException("The provider is down");
            }
<%_ } _%>
<%_ if (routing && routing.strategy === 'classifier') { _%>
            if (prompt.getUserMessage().getText().contains("simple or complex")) {
                text = "simple";
            }
<%_ } _%>
<%_ if (features.outputGuard) { _%>
            // Like a careless model, it repeats its instructions and its secrets when asked.
            if (prompt.getUserMessage().getText().contains("what you were told")) {
                text = prompt.getSystemMessage().getText();
            }
            if (prompt.getUserMessage().getText().contains("key")) {
                text = "I use sk-proj-abcdefghijklmnopqrstuvwxyz";
            }
<%_ } _%>
<%_ if (features.requestTimeout) { _%>
            if (prompt.getUserMessage().getText().contains("Take your time")) {
                try {
                    Thread.sleep(<%= type('java.time.Duration') %>.ofMinutes(1));
                } catch (InterruptedException interrupted) {
                    Thread.currentThread().interrupt();
                    throw new IllegalStateException("Stopped", interrupted);
                }
            }
<%_ } _%>
<%_ if (features.cache) { _%>
            calls.incrementAndGet();
<%_ } _%>
<%_ if (limits.tokens) { _%>
            // Like a real model, it reports the tokens it used: the budget counts them.
            var usage = new <%= type('org.springframework.ai.chat.metadata.DefaultUsage') %>(0, Math.toIntExact(tokensPerReply));
            return new ChatResponse(
                    <%= type('java.util.List') %>.of(new <%= type('org.springframework.ai.chat.model.Generation') %>(new <%= type('org.springframework.ai.chat.messages.AssistantMessage') %>(text))),
                    <%= type('org.springframework.ai.chat.metadata.ChatResponseMetadata') %>.builder().usage(usage).build());
<%_ } else { _%>
            return new ChatResponse(<%= type('java.util.List') %>.of(new <%= type('org.springframework.ai.chat.model.Generation') %>(new <%= type('org.springframework.ai.chat.messages.AssistantMessage') %>(text))));
<%_ } _%>
        }

        Prompt lastPrompt() {
            return lastPrompt;
        }
<%_ if (features.resilience) { _%>

        /** Fails the calls whose prompt matches, as a provider that is down. */
        void failWhen(Predicate<Prompt> failing) {
            this.failing = failing;
        }
<%_ } _%>
<%_ if (features.cache) { _%>

        int calls() {
            return calls.get();
        }
<%_ } _%>
<%_ if (limits.tokens) { _%>

        void reportTokens(long tokens) {
            this.tokensPerReply = tokens;
        }
<%_ } _%>
    }
<%_ if (features.vectorStore) { _%>

    /** Embeds a text by its words: texts with the same words get the same vector, without calling a provider. */
    static class WordsEmbeddingModel implements <%= type('org.springframework.ai.embedding.EmbeddingModel') %> {

        private static final int DIMENSIONS = <%= embedding.dimensions %>;

        @Override
        public <%= type('org.springframework.ai.embedding.EmbeddingResponse') %> call(<%= type('org.springframework.ai.embedding.EmbeddingRequest') %> request) {
            <%= type('java.util.List') %><<%= type('org.springframework.ai.embedding.Embedding') %>> embeddings = new <%= type('java.util.ArrayList') %><>();
            for (String text : request.getInstructions()) {
                embeddings.add(new Embedding(vectorOf(text), embeddings.size()));
            }
            return new EmbeddingResponse(embeddings);
        }

        @Override
        public float[] embed(<%= type('org.springframework.ai.document.Document') %> document) {
            return vectorOf(document.getText());
        }

        @Override
        public int dimensions() {
            return DIMENSIONS;
        }

        private static float[] vectorOf(String text) {
            float[] vector = new float[DIMENSIONS];
            for (String word : text.toLowerCase(<%= type('java.util.Locale') %>.ROOT).split("[^a-z0-9]+")) {
                if (!word.isEmpty()) {
                    vector[Math.floorMod(word.hashCode(), DIMENSIONS)] += 1;
                }
            }
            return vector;
        }
    }
<%_ } _%>
