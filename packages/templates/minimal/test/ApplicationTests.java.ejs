<%_   if (features.approval) { _%>
    @<%= type('org.springframework.beans.factory.annotation.Autowired') %>
    <%= type(`${project.generatedPackage}.approval.Approvals`) %> approvals;

    @<%= type('org.junit.jupiter.api.Test') %>
    void waitsForTheApprovalOfTheUserWhoAsked() throws Exception {
        String conversationId = startConversation("olga", "Please do it");
        String memoryKey = <%= type('java.util.UUID') %>.nameUUIDFromBytes(("olga:" + conversationId).getBytes(<%= type('java.nio.charset.StandardCharsets') %>.UTF_8)).toString();
        <%= type(`${project.generatedPackage}.approval.PendingApproval`) %> pending = approvals.request("olga", memoryKey, conversationId, <%- javaString(approvalTools[0].name) %>, "{}", <%= type('java.time.Duration') %>.ofHours(1));

        <%= staticImport('org.assertj.core.api.Assertions.assertThat') %>(mockMvc.get().uri("/api/approvals").with(jwt().jwt(token -> token.subject("olga"))))
                .bodyJson()
                .extractingPath("$[0].id")
                .isEqualTo(pending.id().toString());
        assertThat(mockMvc.get().uri("/api/approvals").with(jwt().jwt(token -> token.subject("mallory"))))
                .bodyJson()
                .isEqualTo("[]");
        // Only the user who asked decides: for anyone else, the request does not exist.
        assertThat(decide("mallory", pending, false)).hasStatus(HttpStatus.NOT_FOUND);

        assertThat(decide("olga", pending, false)).hasStatusOk().bodyJson().extractingPath("$.conversationId").isEqualTo(conversationId);
        assertThat(chatModel.lastPrompt().getContents()).contains("The user denied the call");
        assertThat(decide("olga", pending, true)).hasStatus(HttpStatus.CONFLICT);
    }

    @Test
    void refusesAnApprovalThatCameTooLate() throws Exception {
        String conversationId = startConversation("pia", "Please do it");
        PendingApproval late = approvals.request("pia", UUID.nameUUIDFromBytes(("pia:" + conversationId).getBytes(StandardCharsets.UTF_8)).toString(), conversationId, <%- javaString(approvalTools[0].name) %>, "{}", Duration.ofSeconds(-1));

        assertThat(decide("pia", late, true)).hasStatus(HttpStatus.GONE);
    }

    private <%= type('org.springframework.test.web.servlet.assertj.MvcTestResult') %> decide(String userId, PendingApproval approval, boolean approved) {
        return mockMvc.post()
                .uri("/api/approvals/{id}", approval.id())
                .with(jwt().jwt(token -> token.subject(userId)))
                .contentType(MediaType.APPLICATION_JSON)
                .content("{\"approved\": " + approved + "}")
                .exchange();
    }

