class <%= project.applicationClass %>Tests {

    @<%= type('org.springframework.beans.factory.annotation.Autowired') %>
    <%= type('org.springframework.test.web.servlet.assertj.MockMvcTester') %> mockMvc;

    @Autowired
    RecordingChatModel chatModel;
<%_ if (features.pii) { _%>

    @Autowired
    <%= type(`${project.generatedPackage}.privacy.PersonalData`) %> personalData;
<%_ } _%>
<%_ if (features.limits) { _%>

    @Autowired
    <%= type(`${project.generatedPackage}.AgentProperties`) %> properties;
<%_ } _%>
<%_ if (features.oidc) { _%>

    @<%= type('org.junit.jupiter.api.Test') %>
    void answersOnTheChatEndpoint() {
        <%= staticImport('org.assertj.core.api.Assertions.assertThat') %>(post("ada", """
                {"message": "Hello"}
                """))
                .hasStatusOk()
                .bodyJson()
                .extractingPath("$.reply")
                .isEqualTo("Hello from the agent");
    }

    @Test
    void sendsTheSystemPromptAndRemembersTheConversation() throws Exception {
        String conversationId = startConversation("grace", "My name is Grace");
        post("grace", """
                {"conversationId": "%s", "message": "What is my name?"}
                """.formatted(conversationId));

        assertThat(chatModel.lastPrompt().getContents()).contains("You are", "My name is Grace", "What is my name?");
    }
<%_   if (prompt.aiDisclosure) { _%>

    @Test
    void tellsClientsTheReplyComesFromAnAi() {
        assertThat(post("ada", """
                {"message": "Hello"}
                """))
                .bodyJson()
                .extractingPath("$.aiGenerated")
                .isEqualTo(true);
    }
<%_   } _%>

<%_   if (features.cache) { _%>
    @Test
    void answersARepeatedFirstQuestionFromTheCacheOfItsUser() {
        int calls = chatModel.calls();

        assertThat(post("carol", """
                {"message": "What are your opening hours?"}
                """)).hasStatusOk();
        assertThat(post("carol", """
                {"message": "what are your   opening hours?"}
                """))
                .hasStatusOk()
                .bodyJson()
                .extractingPath("$.reply")
                .isEqualTo("Hello from the agent");
        assertThat(chatModel.calls()).isEqualTo(calls + 1);

        // Another user never gets it.
        post("dave", """
                {"message": "What are your opening hours?"}
                """);
        assertThat(chatModel.calls()).isEqualTo(calls + 2);
    }

<%_   } _%>
<%_   if (features.chatUi) { _%>
    @Test
    void servesTheChatPageAndItsSettingsWithoutAToken() {
        assertThat(mockMvc.get().uri("/")).hasStatusOk().hasForwardedUrl("index.html");
        assertThat(mockMvc.get().uri("/index.html"))
                .hasStatusOk()
                .headers()
                .hasValue("Content-Security-Policy", "default-src 'self'; img-src 'self' data:; connect-src 'self' https://issuer.example.org; frame-ancestors 'none'; form-action 'self' https://issuer.example.org");
        assertThat(mockMvc.get().uri("/chat-config.json"))
                .hasStatusOk()
                .bodyJson()
                .isLenientlyEqualTo("""
                        {"auth": "oidc", "issuer": "https://issuer.example.org", "clientId": "agent-client"}
                        """);
    }

<%_   } _%>
<%_   if (features.pii) { _%>
    @Test
    void keepsPersonalDataAwayFromTheModel() {
        assertThat(post("ada", """
                {"message": "Please write to ada@example.org"}
                """))
                .hasStatusOk()
                .bodyJson()
                .extractingPath("$.reply")
                .asString()
                .contains("ada@example.org");

        // The model only saw a token, and gave it back: the user gets the address again.
        assertThat(chatModel.lastPrompt().getContents()).contains("[EMAIL_1]").doesNotContain("ada@example.org");
    }

    @Test
    void restoresTheTokensASmallModelWritesWithoutBrackets() {
        personalData.mask("conversation", "Write to ada@example.org");

        // Tool arguments as small models send them: the token without its brackets.
        assertThat(personalData.restore("conversation", "{\"to\": \"EMAIL_1\", \"cc\": \"[EMAIL_1]\"}"))
                .isEqualTo("{\"to\": \"ada@example.org\", \"cc\": \"ada@example.org\"}");
        assertThat(personalData.restore("conversation", "MY_EMAIL_1 and EMAIL_2 stay")).isEqualTo("MY_EMAIL_1 and EMAIL_2 stay");
    }

<%_   } _%>
<%_   if (features.logsWithoutPii) { _%>
    @Test
    @<%= type('org.junit.jupiter.api.extension.ExtendWith') %>(<%= type('org.springframework.boot.test.system.OutputCaptureExtension') %>.class)
    void masksPersonalDataInTheLogs(<%= type('org.springframework.boot.test.system.CapturedOutput') %> output) {
        <%= type('org.slf4j.LoggerFactory') %>.getLogger(<%= project.applicationClass %>Tests.class).info("Ticket from ada@example.org");

        assertThat(output).contains("Ticket from [EMAIL]").doesNotContain("ada@example.org");
    }

<%_   } _%>
<%_   if (features.erasure) { _%>
    @Test
    void erasesTheDataOfAUserWhoAsks() throws Exception {
        String conversationId = startConversation("erin", "Remember that I like tea");
        String othersConversation = startConversation("frank", "Remember that I like coffee");

        assertThat(mockMvc.delete().uri("/api/me").with(jwt().jwt(token -> token.subject("erin")))).hasStatus(HttpStatus.NO_CONTENT);

        assertThat(post("erin", """
                {"conversationId": "%s", "message": "What do I like?"}
                """.formatted(conversationId))).hasStatus(HttpStatus.NOT_FOUND);
        assertThat(post("frank", """
                {"conversationId": "%s", "message": "What do I like?"}
                """.formatted(othersConversation))).hasStatusOk();
    }

    @Test
    void letsOnlyAnAdministratorEraseSomeoneElse() throws Exception {
        String conversationId = startConversation("gina", "Hello");

        assertThat(mockMvc.delete().uri("/api/users/gina").with(jwt().jwt(token -> token.subject("mallory"))))
                .hasStatus(HttpStatus.FORBIDDEN);
        assertThat(mockMvc.delete()
                        .uri("/api/users/gina")
                        .with(jwt().jwt(token -> token.subject("root"))
                                .authorities(new <%= type('org.springframework.security.core.authority.SimpleGrantedAuthority') %>("ROLE_agent-admin"))))
                .hasStatus(HttpStatus.NO_CONTENT);
        assertThat(post("gina", """
                {"conversationId": "%s", "message": "Hello again"}
                """.formatted(conversationId))).hasStatus(HttpStatus.NOT_FOUND);
    }

<%_   } _%>
<%_   if (features.retention) { _%>
    @Test
    void purgesConversationsUnusedForLongerThanTheRetention(@Autowired <%= type('org.springframework.jdbc.core.simple.JdbcClient') %> jdbc, @Autowired <%= type(`${project.generatedPackage}.privacy.RetentionJob`) %> retentionJob) throws Exception {
        String conversationId = startConversation("hugo", "Hello");
        jdbc.sql("UPDATE agent_conversation SET last_used_at = now() - interval '400 days'").update();

        retentionJob.purge();

        assertThat(post("hugo", """
                {"conversationId": "%s", "message": "Hello again"}
                """.formatted(conversationId))).hasStatus(HttpStatus.NOT_FOUND);
    }

<%_   } _%>
<%_   if (features.semanticCache) { _%>
    @Test
    void answersAQuestionOfTheSameMeaningFromTheSemanticCache() {
        int calls = chatModel.calls();

        post("iris", """
                {"message": "What are your opening hours?"}
                """);
        post("iris", """
                {"message": "What are your opening hours!!"}
